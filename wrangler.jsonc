// Universo · Cloudflare Workers + D1 + arquivos estáticos.
// O banco D1 "universo" é criado automaticamente no primeiro deploy (wrangler 4).
// Tabelas: npx wrangler d1 migrations apply universo --remote
// Dados de demonstração (opcional): npm run seed && npx wrangler d1 execute universo --remote --file=seed.sql
{
  "name": "universo",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "universo", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["23 6 * * *"] },
  // Endereços profissionais (a zona guetastudio.com.br está nesta conta; DNS e certificado automáticos)
  "routes": [
    { "pattern": "casamento.guetastudio.com.br", "custom_domain": true },
    { "pattern": "petalaelucas.guetastudio.com.br", "custom_domain": true }
  ],
  // hosts que são a própria plataforma (não são domínio de um casal)
  // MAIL_FROM: remetente dos e-mails (domínio verificado na Resend). A chave RESEND_API_KEY é SEGREDO, só no painel da Cloudflare.
  // PANEL_ORIGIN: endereço do painel nos links dos e-mails.
  "vars": { "PLATFORM_HOSTS": "casamento.guetastudio.com.br", "MAIL_FROM": "Gueta Studio <casamentos@guetastudio.com.br>", "PANEL_ORIGIN": "https://casamento.guetastudio.com.br" },
  "observability": { "enabled": true }
}
