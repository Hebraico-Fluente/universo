// Universo · Cloudflare Workers + D1 + arquivos estáticos.
// O banco D1 "universo" é criado automaticamente no primeiro deploy (wrangler 4).
// Tabelas: npx wrangler d1 migrations apply universo --remote
// Dados de demonstração (opcional): npm run seed && npx wrangler d1 execute universo --remote --file=seed.sql
{
  "name": "universo",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "universo", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["23 6 * * *"] },
  "observability": { "enabled": true }
}
